<?xml version="1.0" encoding="utf-8"?>
<!-- What Android may back up to the user's Google account / copy to a new phone: the library
     (feeds, read state, Saved) and settings. The Content account key (datastore/account), the
     Instapaper sign-in (datastore/instapaper) and the sites' sign-ins are secrets and stay out of
     backups. Full articles live in the cache folder, which Android never backs up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/site_signins.preferences_pb" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="datastore/account.preferences_pb" />
        <exclude domain="file" path="datastore/instapaper.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/site_signins.preferences_pb" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="datastore/account.preferences_pb" />
        <exclude domain="file" path="datastore/instapaper.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
