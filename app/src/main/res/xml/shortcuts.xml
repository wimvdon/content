<?xml version="1.0" encoding="utf-8"?>
<!-- Direct share (#235): the people shared with appear in other apps' share menus (DirectShare.kt
     publishes them as sharing shortcuts in this category). Picking one opens Send with Content,
     with them picked to send to. They are kept out of the launcher's menu, which offers the feed
     folders instead (#251). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="be.wimvandonck.content.ui.SendActivity">
        <data android:mimeType="text/plain" />
        <category android:name="be.wimvandonck.content.category.SHARE_TO_USER" />
    </share-target>
</shortcuts>
