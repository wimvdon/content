<?xml version="1.0" encoding="utf-8"?>
<!-- Content's adaptive-icon background: a soft sky-blue plate, light at the top left to a little
     deeper at the bottom right (#E6F4FD → #CFE6F8), instead of white (owner's wish, 2026-11-22).
     It fills the whole 108dp layer, so every launcher shape (circle, squircle, cookie) shows it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FFE6F4FD" />
                <item android:offset="1" android:color="#FFCFE6F8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
