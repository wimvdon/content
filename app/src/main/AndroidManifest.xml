<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloads the feeds the user subscribes to. The only permission; see PRIVACY.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notifications when something is shared with you (#235), asked for only when they are turned
         on in Settings › Account. See PRIVACY.md. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets Settings › Save and share and Content's share sheet list the apps that accept shared
         links, and the reader's selection menu the apps that act on selected text (Translate, …,
         #251). Package visibility, not a permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".RssReaderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RssReader">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Direct share (#235): the people shared with, in Android's share menu. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Where Instapaper sends the user back after signing in, and where an emailed sign-in
                 link opens (#166). Verified against
                 https://rss-reader-web.wim-d57.workers.dev/.well-known/assetlinks.json (web/public). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="rss-reader-web.wim-d57.workers.dev" />
                <data android:path="/instapaper/callback" />
                <data android:path="/signin" />
            </intent-filter>
        </activity>

        <!-- The custom tab's Save button (#95): the save sheet on top of the tab. Not exported:
             only the tab's PendingIntent, made by this app, opens it. Rotating keeps the sheet. -->
        <activity
            android:name=".ui.SaveFromTabActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.RssReader.Translucent" />

        <!-- Links shared from other apps (#97, #103): only the Save and share sheet (#256), over the
             app that shared it, not the whole of Reader. The people shared with show at the top of
             the share menu too (res/xml/shortcuts.xml). An alias, so the tab's own screen stays
             unexported. -->
        <activity-alias
            android:name=".ui.ShareActivity"
            android:targetActivity=".ui.SaveFromTabActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <!-- Firebase's pokes when something is shared (#235, push/). Not exported: only Firebase,
             inside this app, starts it. -->
        <service
            android:name=".push.SharedMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- No Firebase token until notifications are turned on (PushNotifications.turnOn). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>

</manifest>
