<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloads the feeds the user subscribes to. The only permission; see PRIVACY.md. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets Settings › Save and share list the apps that accept shared links, so the Save and
         Share buttons can send straight to one. Package visibility, not a permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".RssReaderApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RssReader">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where Instapaper sends the user back after signing in. Verified against
                 https://rss-reader-web.wim-d57.workers.dev/.well-known/assetlinks.json (web/public). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="rss-reader-web.wim-d57.workers.dev" />
                <data android:path="/instapaper/callback" />
            </intent-filter>
        </activity>

        <!-- The custom tab's Save button (#95): the save sheet on top of the tab. Not exported:
             only the tab's PendingIntent, made by this app, opens it. Rotating keeps the sheet. -->
        <activity
            android:name=".ui.SaveFromTabActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.RssReader.Translucent" />

        <!-- Links shared from other apps (#97, #103): only the save sheet, over the app that shared
             it, not the whole of Reader. An alias, so the tab's own screen stays unexported. -->
        <activity-alias
            android:name=".ui.ShareActivity"
            android:targetActivity=".ui.SaveFromTabActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
