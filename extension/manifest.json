{
  "manifest_version": 3,
  "name": "Content",
  "version": "1.0.0",
  "description": "Loads pages for the Content web app from your own browser, with your own sign-ins, and saves the page you're on to Content.",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "Save to Content", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://rss-reader-web.wim-d57.workers.dev/*", "http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "content-extension@wimvandonck.be", "strict_min_version": "121.0" } }
}
